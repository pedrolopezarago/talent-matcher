# Backend only — never expose to the browser. Copy to .env and fill in the keys.
# LLM: anthropic | openai_compat (OpenRouter, Azure OpenAI...) | fake (tests)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_EXTRACT=claude-sonnet-5-5
LLM_MODEL_SCREEN=claude-haiku-5-5
LLM_MODEL_JUDGE=claude-sonnet-5-5
LLM_MODEL_TEAM=claude-haiku-5-5

# Embeddings: none (keyword retrieval) | openai_compat | voyage
EMBED_PROVIDER=none
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=512

# Local: docker compose up -d   ·  Later: Supabase connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talent

# Cost / latency knobs
SCREEN_MAX_PER_ROLE=1000
JUDGE_TOP_N=40
MAX_LLM_CONCURRENCY=8
MAX_USD_PER_REQUEST=0.75

# Frontend (frontend/.env.local)
# VITE_API_URL=http://localhost:8000   (in Vercel: set to the deployed backend URL)

# Backend CORS: allow the deployed frontend
CORS_ORIGINS=http://localhost:5173,https://talent-matcher-five.vercel.app
