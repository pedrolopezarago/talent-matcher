# Backend only — never expose to the browser. Any OpenAI-compatible provider works.
# OpenRouter (OpenAI-compatible). Free models end in :free and are rate-limited per day.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional per-task overrides (fall back to LLM_MODEL)
LLM_MODEL_EXTRACT=
LLM_MODEL_JUDGE=
LLM_MODEL_TEAM=

# Paid but ~$1 for all 190k profiles; supports dimensions=512. Free alt: nvidia/nemotron-3.5-embed-1b:free (rate-limited)
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=512

# Local: docker compose up -d   ·  Later: Supabase connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talent

# Frontend (frontend/.env.local)
# VITE_API_URL=http://localhost:8000   (in Vercel: set to the deployed backend URL)

# Backend CORS: allow the deployed frontend
CORS_ORIGINS=http://localhost:5173,https://talent-matcher-five.vercel.app
