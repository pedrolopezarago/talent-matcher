# Backend only — never expose to the browser. Any OpenAI-compatible provider works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional per-task overrides (fall back to LLM_MODEL)
LLM_MODEL_EXTRACT=
LLM_MODEL_JUDGE=
LLM_MODEL_TEAM=

EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=512

# Local: docker compose up -d   ·  Later: Supabase connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talent

# Frontend (frontend/.env.local)
# VITE_API_URL=http://localhost:8000
